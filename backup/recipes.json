      {
        "qty": 1,
        "item": "red wine ((I use Cabernet Sauvignon))",
        "note": null,
        "unit": "cup",
        "qty_max": null
      },
      {
        "qty": 1,
        "item": "yukon gold potatoes",
        "note": null,
        "unit": "lb",
        "qty_max": null
      },
      {
        "qty": 4,
        "item": "large carrots",
        "note": null,
        "unit": null,
        "qty_max": null
      },
      {
        "qty": 4,
        "item": "celery ribs",
        "note": null,
        "unit": null,
        "qty_max": null
      },
      {
        "qty": 2,
        "item": "tomato paste",
        "note": null,
        "unit": "tbsp",
        "qty_max": null
      },
      {
        "qty": 2,
        "item": "fresh thyme",
        "note": null,
        "unit": "sprig",
        "qty_max": null
      },
      {
        "qty": 1,
        "item": "fresh rosemary",
        "note": null,
        "unit": "sprig",
        "qty_max": null
      },
      {
        "qty": 2,
        "item": "bay leaves",
        "note": null,
        "unit": null,
        "qty_max": null
